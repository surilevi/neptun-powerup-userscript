{
  "name": "neptun-powerup-userscript",
  "version": "3.4.0",
  "description": "Neptun PowerUp! userscript for course and exam workflows",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "homepage": "https://github.com/surilevi/neptun-powerup-userscript#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/surilevi/neptun-powerup-userscript.git"
  },
  "bugs": {
    "url": "https://github.com/surilevi/neptun-powerup-userscript/issues"
  },
  "keywords": [
    "neptun",
    "tampermonkey",
    "userscript",
    "typescript",
    "student-portal"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint src/ tests/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "pnpm audit --audit-level moderate"
  },
  "author": "surilevi",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vite-plugin-monkey": "^8.0.6",
    "vitest": "^4.1.10"
  }
}
